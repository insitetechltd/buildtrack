    "android": {
      "package": "com.insite.hq",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E7F4F8"
      }
    },
    "plugins": [
      "expo-font"
    ],
    "owner": "insitetech",
    "extra": {
      "eas": {
        "projectId": "d82603e8-9bcf-4f6f-942a-404ac825a4de"
      }
    }
  }
}
