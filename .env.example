EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — never commit real keys. Secret/restricted keys must NOT go in the iOS app.
# Prefer a restricted key (rk_live_ / rk_test_) with Products, Prices, Payment Links write.
STRIPE_SECRET_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Legacy Payment Link removed — Profile checkout uses create-checkout-session (BILL-E).

# Stripe webhook (BILL-C Edge Function secrets — set in Supabase Dashboard, not in app)
STRIPE_WEBHOOK_SECRET=

# BILL-E create-checkout-session Edge secrets (Dashboard, not in app)
# STRIPE_CHECKOUT_SUCCESS_URL=taskr://profile?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=taskr://profile?checkout=cancel
# STRIPE_TRIAL_PERIOD_DAYS=30
