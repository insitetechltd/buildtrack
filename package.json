{
  "name": "template-app-53",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:tunnel": "expo start --tunnel",
    "expo-go": "expo start",
    "expo-go:clear": "expo start --clear",
    "expo-go:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "android:build": "./build-android.sh",
    "android:build:install": "./build-android.sh --install",
    "android:build:clean": "./build-android.sh --clean",
    "ios": "expo run:ios",
    "maestro:doctor": "bash -lc 'set -euo pipefail; MLH=\"${MAESTRO_LOCAL_HOME:-/tmp/maestro-tmp-home}\"; mkdir -p \"$MLH/.maestro/deps\"; export MAESTRO_OPTS=\"${MAESTRO_OPTS:-} -Duser.home=$MLH\"; MBIN=\"\"; if command -v maestro >/dev/null 2>&1; then MBIN=\"$(command -v maestro)\"; elif [ -x \"$HOME/.maestro/bin/maestro\" ]; then MBIN=\"$HOME/.maestro/bin/maestro\"; fi; if [ -z \"$MBIN\" ]; then echo Missing Maestro CLI — run npm run maestro:install; exit 127; fi; echo \"Maestro CLI: $MBIN\"; \"$MBIN\" --version; echo \"(maestro doctor skipped: sandbox may block dep chmod; use bash ./scripts/maestro/run-local.sh test to validate runtime)\"'",
    "maestro:install": "curl -Lfs 'https://get.maestro.mobile.dev' | bash",
    "maestro:test": "bash ./scripts/maestro/run-local.sh test",
    "maestro:test:smoke": "bash ./scripts/maestro/run-local.sh test maestro/flows/launch-smoke.yaml",
    "maestro:sim-status": "bash ./scripts/maestro/sim-lock.sh status",
    "maestro:resource-status": "bash ./scripts/maestro/resource-lock.sh status",
    "maestro:locks": "bash -lc 'set -euo pipefail; echo \"=== sim-lock ===\"; bash ./scripts/maestro/sim-lock.sh status; echo; echo \"=== resource-lock ===\"; bash ./scripts/maestro/resource-lock.sh status'",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:auth": "jest src/state/__tests__/authStore.test.ts",
    "test:tasks": "jest src/state/__tests__/taskStore.supabase.unit.test.ts src/state/__tests__/taskStore.supabase.workflow.test.ts",
    "test:projects": "jest src/state/__tests__/projectStore",
    "test:uploads": "jest src/api/__tests__/fileUploadService",
    "test:components": "jest src/components/__tests__",
    "test:integration": "jest src/__tests__/integration",
    "test:photo-flow": "jest --runInBand src/modules/captureSession/__tests__/CaptureSessionModule.overlay.test.tsx src/modules/captureSession/__tests__/cameraDraftPinQueue.test.ts src/modules/captureSession/__tests__/sessionDraftStore.test.ts src/modules/captureSession/__tests__/CaptureSessionCameraScreen.shutter.test.tsx src/screens/__tests__/InAppLibraryPickerScreen.permission.test.tsx src/navigation/__tests__/photoFlowNavigation.test.ts src/utils/__tests__/bakePhotoDraw.test.ts src/utils/__tests__/mergeTaskAttachments.test.ts src/utils/__tests__/photoPreviewEdit.test.ts src/utils/__tests__/photoPreviewDraw.test.ts src/ui/viewAdapters/__tests__/usePhotoSelectionViewAdapter.test.ts src/__tests__/integration/PhotoSelectionScreen.batch-review.test.tsx",
    "test:regression": "npm run test:tasks && npm run test:uploads && npm run test:components && npm run test:integration",
    "test:e2e:journeys": "jest src/__tests__/journeys --runInBand",
    "test:e2e:maestro:smoke": "bash ./scripts/maestro/run-local.sh test maestro/flows/launch-smoke.yaml",
    "test:e2e:maestro:rc-worker-be": "bash ./scripts/maestro/run-create-task-photo-one.sh P01 && bash ./scripts/maestro/run-update-progress-photo-one.sh U01",
    "test:e2e:maestro:dual-user": "bash ./scripts/maestro/run-dual-user-gate.sh",
    "test:e2e:maestro:task-core": "bash ./scripts/maestro/run-local.sh test maestro/flows/task-core-live-create.yaml && bash ./scripts/maestro/run-local.sh test maestro/flows/task-core-live-assign.yaml && bash ./scripts/maestro/run-local.sh test maestro/flows/task-core-live-progress.yaml && bash ./scripts/maestro/run-local.sh test maestro/flows/task-core-live-completion.yaml && bash ./scripts/maestro/run-local.sh test maestro/flows/task-core-live-photo-upload.yaml",
    "test:e2e:maestro:qa01": "bash ./scripts/maestro/run-local.sh test maestro/flows/qa01-scenario-a-rejection-loop.yaml && bash ./scripts/maestro/run-local.sh test maestro/flows/qa01-scenario-b-overdue-crunch.yaml && bash ./scripts/maestro/run-local.sh test maestro/flows/qa01-scenario-c-isolation-wall.yaml && bash ./scripts/maestro/run-local.sh test maestro/flows/qa01-scenario-d-iphone17-viewport.yaml",
    "test:e2e:maestro:create-task-photo": "bash ./scripts/maestro/run-create-task-photo-suite.sh",
    "test:e2e:maestro:create-task-photo:one": "bash ./scripts/maestro/run-create-task-photo-one.sh",
    "test:e2e:maestro:update-progress-photo": "bash ./scripts/maestro/run-update-progress-photo-suite.sh",
    "test:e2e:maestro:update-progress-photo:one": "bash ./scripts/maestro/run-update-progress-photo-one.sh",
    "test:e2e:maestro:critical": "bash ./scripts/maestro/run-local.sh test maestro/flows",
    "test:e2e:maestro:journeys": "bash ./scripts/maestro/run-local.sh test maestro/flows/journey-projectswitch-create-taskdetail-update.yaml && bash ./scripts/maestro/run-local.sh test maestro/flows/journey-login-switch-projects.yaml",
    "test:confidence": "npm run test:regression && npm run test:e2e:journeys",
    "test:simulation": "USE_REAL_SUPABASE=1 jest src/__tests__/simulation",
    "test:simulation:ui": "jest src/__tests__/simulation --testPathIgnorePatterns=\"\\\\.supabase\\\\.test\\\\.\"",
    "test:parity:unit": "jest src/__tests__/parity/harness/__tests__ src/__tests__/parity/adapters/__tests__",
    "test:parity:old": "PARITY_TARGET=old USE_REAL_SUPABASE=1 jest src/__tests__/parity/scenarios --runInBand",
    "test:parity:new": "PARITY_TARGET=new USE_REAL_SUPABASE=1 jest src/__tests__/parity/scenarios --runInBand",
    "test:parity": "npm run test:parity:unit",
    "greenfield:apply": "bash scripts/greenfield/apply_remote.sh",
    "greenfield:apply:parity": "GREENFIELD_RUN_PARITY=1 bash scripts/greenfield/apply_remote.sh",
    "test:all": "jest --coverage --verbose",
    "dev:doctor": "bash \"./scripts/dev/doctor.sh\"",
    "validate:local": "bash \"./scripts/validation/validate-local.sh\"",
    "validate:local:confidence": "VALIDATE_LOCAL_RUN_JOURNEYS=1 bash \"./scripts/validation/validate-local.sh\"",
    "validate:local:maestro": "npm run validate:local:confidence && npm run test:e2e:maestro:journeys",
    "push:validated": "bash \"./scripts/validation/push-validated.sh\"",
    "setup-auth": "tsx scripts/setup-login-users.ts",
    "setup-auth:cleanup": "tsx scripts/setup-login-users.ts cleanup",
    "setup-auth:legacy": "node scripts/automated-setup.js",
    "reset-passwords": "node scripts/reset-passwords.js",
    "eas-build-post-install": "node ./scripts/eas/eas-build-post-install.js"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-constants",
