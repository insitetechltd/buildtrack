*.keystore
keystore.properties
**/keystore.properties

# Build artifacts
*.bundle/
**/*.bundle/
*.ipa
*.apk
*.aab
*.app

# Large binary files that shouldn't be in git
*.tar.gz
*.zip
node-v*/
node.tar.gz
node 2.tar.gz
ExpoGo*.tar.gz
ExpoGo*.zip
ExpoGo*.ipa
Expo Go.app/
ExpoGo.app/
*.app.tar.gz
archive/
google-service-account.json

