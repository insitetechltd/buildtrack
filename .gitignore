# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Local secret quarantine
.env
.env.*
!.env.example
credentials.json
credentials.json.*

# EAS local keystore exports and logs (never commit)
eas-keystores/

